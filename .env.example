APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=marketing
DB_USERNAME=user_marketing
DB_PASSWORD=gantengbanget

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Inventory -- sumber harga modal (HPP).
# CRM_API_KEY diterima lewat jalur aman dan hanya diisi di env server, bukan di
# repo dan bukan di berkas yang ikut ter-build ke browser. Jangan pernah memberi
# nilai ini awalan VITE_, karena semua yang berawalan VITE_ ikut terkirim ke sisi klien.
INVENTORY_BASE_URL=
CRM_API_KEY=
INVENTORY_TIMEOUT=10

# Kode perusahaan yang boleh membuka halaman Harga Modal, dipisah koma.
# Lihat kolom `code` di tabel companies. Dikosongkan berarti tanpa pembatasan
# perusahaan, dan izin per role saja yang berlaku.
HARGA_MODAL_PERUSAHAAN=ATC

# Nol berarti tanpa cache -- setiap kunjungan tanya langsung ke inventory.
# Batas atas dipagari 300 detik oleh aplikasi. Pakai store non-persisten kalau diaktifkan.
HARGA_MODAL_CACHE_TTL=0
HARGA_MODAL_CACHE_STORE=
